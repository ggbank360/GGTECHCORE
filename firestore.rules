rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Projects Collection
    // Public can read published projects. Admin can manage all projects.
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // 2. Bookings Collection
    // Customers can submit booking ideas; Admin can view and update statuses.
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // 3. Inquiries Collection
    // Public can submit contact messages; Admin can view and manage inquiries.
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // 4. Reviews Collection
    // Clients can submit verified reviews; public can read reviews; Admin can moderate.
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
