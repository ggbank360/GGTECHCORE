rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requester is the authorized administrator
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ggbank360@gmail.com';
    }

    // 1. Projects Collection
    // Public read only if published == true; write only for admin
    match /projects/{projectId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 2. Bookings Collection
    // Public create; read, update and delete only for admin
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 3. Inquiries Collection
    // Public create; read, update and delete only for admin
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 4. Reviews Collection
    // Public read and create; update and delete only for admin
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
