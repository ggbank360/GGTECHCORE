# ==============================================================
# GG TECHCORE — Environment Configuration (.env.example)
# ==============================================================
# Copy this file to .env and replace the placeholder values with your real credentials.
# Do not commit real secrets or production credentials to version control.

# --- Firebase Configuration (Firestore & Auth) ---
# Obtain these from Firebase Console: Project Settings > General > Your Web App
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=ggbank-example.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://ggbank-example-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=ggbank-example
VITE_FIREBASE_STORAGE_BUCKET=ggbank-example.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Cloudinary Configuration (Client-Side Asset Uploads) ---
# Obtain these from your Cloudinary Dashboard & Upload Preset settings
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_API_KEY=123456789012345
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
