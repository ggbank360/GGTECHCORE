# ==============================================================
# GG TECHCORE — Environment Configuration
# ==============================================================

# --- Firebase Configuration (Firestore & Auth) ---
# Obtain these from your Firebase Console: Project Settings > General > Web Apps
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=gg-techcore-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gg-techcore-prod
VITE_FIREBASE_STORAGE_BUCKET=gg-techcore-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Cloudinary Configuration (Secure Client-Side Uploads) ---
# Create an Unsigned Upload Preset in Cloudinary Settings > Upload > Upload Presets
# Note: Never expose your Cloudinary API Secret in client code!
VITE_CLOUDINARY_CLOUD_NAME=gg-techcore
VITE_CLOUDINARY_UPLOAD_PRESET=gg_techcore_unsigned

# Note: If environment variables are omitted or empty, the application
# automatically operates in a resilient demo mode with persistent local cache
# and mock Cloudinary previews, so you can test and demonstrate all features immediately!
